# ============================================================
# Resume Builder — .gitignore
# ============================================================

# ---------- Build outputs ----------
# Maven build directory (regenerated by 'mvn compile')
target/

# IntelliJ IDEA build output
out/

# Compiled class files (anywhere in the project)
*.class

# ---------- IDE files ----------
# IntelliJ IDEA project files (user-specific, not shared)
.idea/
*.iml

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/

# ---------- Credentials ----------
# Contains real database password — NEVER push this
src/config.properties

# ---------- Generated files ----------
# PDFs generated by the app
*.pdf

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
