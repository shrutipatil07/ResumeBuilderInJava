<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========== Project Coordinates ========== -->
    <groupId>com.resumegenerator</groupId>
    <artifactId>resume-generator</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Resume Generator</name>
    <description>A Swing-based resume builder that generates PDF resumes</description>

    <!-- ========== Properties ========== -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ========== Dependencies ========== -->
    <dependencies>

        <!--
            iText 5 — PDF generation library.
            Used by com.resumegenerator.export.PDFGenerator to create
            resume PDFs (Document, PdfWriter, Paragraph classes).
            Version pinned to 5.5.13.3 to match the existing project.
        -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>

        <!--
            MySQL Connector/J — the official JDBC driver for MySQL.
            Allows Java code to connect to a MySQL database using
            java.sql.DriverManager / java.sql.Connection.
            Scope is "runtime" because your code only uses the
            standard java.sql.* interfaces at compile time; the
            connector is loaded by the JVM at runtime via SPI.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            jBCrypt — password hashing library.
            Used by AuthenticationService to hash passwords before
            storing them in the login_users table. BCrypt is a slow,
            salted hashing algorithm designed specifically for passwords:
              • Automatically generates a random salt per hash
              • Intentionally slow to resist brute-force attacks
              • Produces a 60-character string like:
                $2a$10$N9qo8uLOickgx2ZMRZoMye...
        -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

    </dependencies>

    <!-- ========== Build Configuration ========== -->
    <build>

        <!--
            Source directory override.
            Maven defaults to src/main/java, but the existing project
            keeps sources directly under src/. This avoids moving any files.
        -->
        <sourceDirectory>src</sourceDirectory>

        <!--
            Resource directory override.
            Maven defaults to src/main/resources, but config.properties
            lives in src/. We include only *.properties files so that
            .java files aren't copied twice.
        -->
        <resources>
            <resource>
                <directory>src</directory>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>

        <plugins>

            <!--
                Maven Compiler Plugin — ensures the project compiles
                with Java 17 source/target compatibility.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!--
                Maven JAR Plugin — sets the Main-Class manifest entry
                so the packaged JAR is directly executable with:
                    java -jar resume-generator-1.0-SNAPSHOT.jar
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.resumegenerator.ResumeApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.resumegenerator.ResumeApp</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
